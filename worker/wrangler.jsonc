{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio-counter",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"observability": {
		"enabled": true,
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "COUNTERS",
				"class_name": "Counters",
			},
		],
	},
	// Which classes this Worker exports, and how their storage is backed.
	// SQLite is the only kind on the free plan. This replaces the older
	// `migrations` array: the namespace was provisioned by it and stays
	// exactly where it was — only the shape of the declaration changed.
	"exports": {
		"Counters": { "type": "durable-object", "storage": "sqlite" },
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://ahincho.github.io,http://localhost:4321",
		// Counted once per visitor per day, and never go down.
		"COUNTER_KEYS": "site-visits,cv-downloads",
		// One row per visitor, which they can take back.
		"REACTION_KEYS": "spark-match,nova,assistant",
	},
}
