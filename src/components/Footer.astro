---
import { translations, getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].footer;

// Only true once the site is actually pointed at the counter Worker. A
// privacy note is the last place to describe something that is not happening.
const counterUrl = import.meta.env.PUBLIC_COUNTER_URL;
---

<footer>
	<div class="container inner">
		<p>{t.rights}</p>
		<p class="made">
			{t.madeWith}{' '}
			<a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
			· <a href="https://github.com/ahincho" target="_blank" rel="noopener noreferrer">GitHub</a>
			· <a href="https://www.linkedin.com/in/ahincho" target="_blank" rel="noopener noreferrer"
				>LinkedIn</a
			>
		</p>
		{counterUrl && <p class="note">{t.privacy}</p>}
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding-block: 1.8rem;
		margin-top: 2rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--text-faint);
	}

	.note {
		/* Its own line under the two columns, whether or not they wrapped. */
		flex-basis: 100%;
		font-size: 0.78rem;
	}

	.made a {
		color: var(--text-muted);
	}

	.made a:hover {
		color: var(--accent);
	}
</style>
