---
import { translations, getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].contact;
---

<section id="contact" class="section">
	<div class="container">
		<div class="box">
			<p class="section-eyebrow">{t.eyebrow}</p>
			<h2>{t.title}</h2>
			<p class="lead">{t.lead}</p>
			<div class="actions">
				<a class="btn btn-primary" href="mailto:ahincho@unsa.edu.pe">
					<svg
						width="17"
						height="17"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-10 6L2 7"></path>
					</svg>
					{t.emailCta}
				</a>
				<a
					class="btn btn-ghost"
					href="https://www.linkedin.com/in/ahincho"
					target="_blank"
					rel="noopener noreferrer">LinkedIn</a
				>
				<a
					class="btn btn-ghost"
					href="https://github.com/ahincho"
					target="_blank"
					rel="noopener noreferrer">GitHub</a
				>
				<a class="btn btn-ghost" href="/Angel-Hincho-CV.pdf" download data-cv>
					<svg
						width="17"
						height="17"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<path d="m7 10 5 5 5-5"></path>
						<path d="M12 15V3"></path>
					</svg>
					{t.cvCta}
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	const endpoint = import.meta.env.PUBLIC_COUNTER_URL;

	// Counted, never displayed: how often the CV is taken is worth knowing,
	// but it is not a number that belongs on the page. keepalive lets the
	// request outlive the click that starts the download.
	if (endpoint) {
		document.querySelector('[data-cv]')?.addEventListener('click', () => {
			fetch(`${endpoint}/v1/counters/cv-downloads`, {
				method: 'POST',
				keepalive: true,
			}).catch(() => {});
		});
	}
</script>

<style>
	.box {
		text-align: center;
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 3.5rem 2rem;
		position: relative;
		overflow: hidden;
	}

	.box::before {
		content: '';
		position: absolute;
		bottom: -14rem;
		left: 50%;
		transform: translateX(-50%);
		width: 34rem;
		height: 22rem;
		background: radial-gradient(circle, var(--accent-dim) 0%, transparent 70%);
		pointer-events: none;
	}

	h2 {
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.lead {
		color: var(--text-muted);
		max-width: 32rem;
		margin: 1rem auto 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
		margin-top: 2.2rem;
		position: relative;
	}
</style>
