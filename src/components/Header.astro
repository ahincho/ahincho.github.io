---
import { translations, getLang, defaultLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].nav;

const homePath = lang === defaultLang ? '/' : `/${lang}/`;

// Keep the visitor on the same page when they switch language.
const path = Astro.url.pathname;
const esPath = path === '/en' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;
const languages = [
	{ code: 'es', path: esPath },
	{ code: 'en', path: esPath === '/' ? '/en/' : `/en${esPath}` },
];
---

<header>
	<div class="container inner">
		<a class="logo" href={homePath} aria-label="Angel Hincho">ah<span>.</span></a>
		<button
			id="nav-toggle"
			class="menu"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label={t.menuToggle}
			title={t.menuToggle}
		>
			<svg
				class="bars"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
			<svg
				class="cross"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6 6 18"></path>
			</svg>
		</button>
		<nav id="site-nav" aria-label={t.ariaSections} data-open="false">
			{t.links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<div class="lang" aria-label={t.langSwitcher}>
			{
				languages.map((l) => (
					<a
						href={l.path}
						class:list={[{ active: l.code === lang }]}
						aria-current={l.code === lang ? 'true' : undefined}
					>
						{l.code.toUpperCase()}
					</a>
				))
			}
		</div>
		<button id="theme-toggle" aria-label={t.themeToggle} title={t.themeToggle}>
			<svg
				class="sun"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
			>
				<circle cx="12" cy="12" r="4"></circle>
				<path
					d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
				></path>
			</svg>
			<svg
				class="moon"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
			</svg>
		</button>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('site-nav');

	function setMenu(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		if (nav) nav.dataset.open = String(open);
	}

	toggle?.addEventListener('click', () => {
		setMenu(toggle.getAttribute('aria-expanded') !== 'true');
	});

	// Every link jumps to a section of this page, so the panel has to get out of the way.
	nav?.addEventListener('click', (event) => {
		if (event.target instanceof HTMLAnchorElement) setMenu(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			toggle.focus();
		}
	});

	// Rotating a phone can cross the breakpoint; the button disappears but its state would linger.
	matchMedia('(min-width: 801px)').addEventListener('change', () => setMenu(false));

	const themeToggle = document.getElementById('theme-toggle');
	themeToggle?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 78%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 4rem;
	}

	.logo {
		font-family: var(--font-mono);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text);
		letter-spacing: -0.03em;
	}

	.logo span {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}

	nav a {
		color: var(--text-muted);
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.45rem 0.8rem;
		border-radius: 8px;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--text);
		background: var(--bg-soft);
	}

	.lang {
		flex-shrink: 0;
		display: flex;
		border: 1px solid var(--border-strong);
		border-radius: 10px;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.lang a {
		padding: 0.42rem 0.55rem;
		color: var(--text-faint);
	}

	.lang a:hover {
		color: var(--text);
	}

	.lang a.active {
		color: var(--accent);
		background: var(--accent-dim);
	}

	.menu,
	#theme-toggle {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.35rem;
		height: 2.35rem;
		border-radius: 10px;
		border: 1px solid var(--border-strong);
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.menu:hover,
	#theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent-border);
	}

	/* The hamburger only exists below the breakpoint, where the links stop fitting. */
	.menu {
		display: none;
	}

	.menu .cross {
		display: none;
	}

	.menu[aria-expanded='true'] .bars {
		display: none;
	}

	.menu[aria-expanded='true'] .cross {
		display: block;
	}

	.sun {
		display: none;
	}

	:global([data-theme='light']) .sun {
		display: block;
	}

	:global([data-theme='light']) .moon {
		display: none;
	}

	@media (max-width: 800px) {
		/* The trigger sits before the panel in the DOM but belongs on the far right. */
		.menu {
			display: grid;
			order: 3;
		}

		.lang {
			order: 1;
			margin-left: auto;
		}

		#theme-toggle {
			order: 2;
		}

		.inner {
			gap: 0.6rem;
		}

		nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			gap: 0.1rem;
			margin: 0;
			padding: 0.6rem 0 1rem;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			box-shadow: var(--shadow);
		}

		nav[data-open='false'] {
			display: none;
		}

		nav a {
			padding: 0.7rem 1.5rem;
			border-radius: 0;
			font-size: 1rem;
		}
	}
</style>
