---
import { translations, getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].about;
---

<section id="about" class="section">
	<div class="container">
		<p class="section-eyebrow">{t.eyebrow}</p>
		<h2 class="section-title">{t.title}</h2>
		<div class="cols">
			<div class="text">
				{t.paragraphs.map((p) => <p set:html={p} />)}
			</div>
			<aside class="focus" aria-label={t.focusTitle}>
				<h3>{t.focusTitle}</h3>
				<ul>
					{t.focus.map((item) => <li>{item}</li>)}
				</ul>
			</aside>
		</div>
	</div>
</section>

<style>
	.cols {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.text {
		display: grid;
		gap: 1.1rem;
		color: var(--text-muted);
		font-size: 1.02rem;
	}

	.text :global(strong) {
		color: var(--text);
		font-weight: 600;
	}

	.focus {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1.5rem 1.6rem;
	}

	.focus h3 {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.focus ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}

	.focus li {
		position: relative;
		padding-left: 1.4rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.focus li::before {
		content: '▸';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.cols {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
