---
import { translations, getLang, defaultLang } from '../i18n';
import VideoDemo from './VideoDemo.astro';
import NovaArchitecture from './NovaArchitecture.astro';
import AssistantFlow from './AssistantFlow.astro';
import Reactions from './Reactions.astro';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].projects;

const prefix = lang === defaultLang ? '' : `/${lang}`;
---

<section id="projects" class="section">
	<div class="container">
		<p class="section-eyebrow">{t.eyebrow}</p>
		<h2 class="section-title">{t.title}</h2>
		<p class="section-lead">{t.lead}</p>

		<article class="card">
			<div class="head">
				<h3 class="name">{t.sparkMatch.title}</h3>
				<div class="badges">
					<span class="badge accent">{t.sparkMatch.badgeTfp}</span>
					<span class="badge status">{t.sparkMatch.badgeStatus}</span>
				</div>
			</div>
			<p class="tagline">{t.sparkMatch.tagline}</p>
			<p class="description">{t.sparkMatch.description}</p>
			<VideoDemo />
			<div class="foot">
				<a class="cta" href={`${prefix}/projects/spark-match/`}>
					{t.sparkMatch.cta}
					<span aria-hidden="true">→</span>
				</a>
				<Reactions project="spark-match" />
			</div>
		</article>

		<article class="card">
			<div class="head">
				<h3 class="name">{t.nova.title}</h3>
				<div class="badges">
					<span class="badge accent">{t.nova.badgeKind}</span>
					<span class="badge status">{t.nova.badgeStatus}</span>
				</div>
			</div>
			<p class="tagline">{t.nova.tagline}</p>
			<p class="description">{t.nova.description}</p>
			<NovaArchitecture />
			<div class="foot">
				<a class="cta" href={`${prefix}/projects/nova/`}>
					{t.nova.cta}
					<span aria-hidden="true">→</span>
				</a>
				<Reactions project="nova" />
			</div>
		</article>

		<article class="card">
			<div class="head">
				<h3 class="name">{t.assistant.title}</h3>
				<div class="badges">
					<span class="badge accent">{t.assistant.badgeKind}</span>
					<span class="badge status">{t.assistant.badgeStatus}</span>
				</div>
			</div>
			<p class="tagline">{t.assistant.tagline}</p>
			<p class="description">{t.assistant.description}</p>
			<AssistantFlow />
			<div class="foot">
				<a class="cta" href={`${prefix}/projects/assistant/`}>
					{t.assistant.cta}
					<span aria-hidden="true">→</span>
				</a>
				<Reactions project="assistant" />
			</div>
		</article>

		<a class="all" href={`${prefix}/projects/`}>
			{t.all}
			<span aria-hidden="true">→</span>
		</a>
	</div>
</section>

<style>
	.section-lead {
		color: var(--text-muted);
		max-width: 44rem;
		/* .section-title already carries the gap below the heading. */
		margin-top: -1.6rem;
		margin-bottom: 2.5rem;
	}

	.card {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 2.2rem 2.4rem;
		box-shadow: var(--shadow);
		position: relative;
		overflow: hidden;
	}

	.card + .card {
		margin-top: 2rem;
	}

	.card::before {
		content: '';
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, var(--accent), transparent 70%);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.name {
		font-size: clamp(1.5rem, 3vw, 1.9rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.tagline {
		font-size: 1.05rem;
		font-weight: 600;
		margin: 0.55rem 0 0.8rem;
	}

	.badges {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-left: auto;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.28rem 0.7rem;
		border-radius: 999px;
	}

	.badge.accent {
		color: var(--accent);
		background: var(--accent-dim);
		border: 1px solid var(--accent-border);
	}

	.badge.status {
		color: var(--text-muted);
		border: 1px solid var(--border-strong);
	}

	.description {
		color: var(--text-muted);
		max-width: 60rem;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.4rem;
		margin-top: var(--space-block);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent);
		border-bottom: 1px solid var(--accent-border);
		padding-bottom: 0.15rem;
	}

	.cta span {
		transition: transform 0.2s ease;
	}

	.cta:hover span,
	.cta:focus-visible span {
		transform: translateX(0.25rem);
	}

	.all {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.6rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.all:hover {
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.card {
			padding: 1.5rem 1.3rem;
		}
	}
</style>
