---
import { translations, getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].hero;

const counterUrl = import.meta.env.PUBLIC_COUNTER_URL;
const chatUrl = import.meta.env.PUBLIC_CHAT_URL;

const stackJson = `{
  "backend":  ["Spring Boot", "NestJS",
               "FastAPI", ".NET"],
  "frontend": ["React", "Angular", "Astro"],
  "cloud":    ["AWS", "Azure", "GCP"],
  "devops":   ["GitHub Actions", "Terraform"],
  "ia":       ["LangChain", "Bedrock", "MLOps"]
}`;
---

<section id="top" class="hero">
	<div class="container grid">
		<div class="intro">
			<p class="eyebrow">{t.location}</p>
			<h1>Angel Hincho</h1>
			<p class="role">{t.role}</p>
			<p class="lead">{t.lead}</p>
			<div class="actions">
				<a class="btn btn-primary" href="#projects">{t.ctaProject}</a>
				<a class="btn btn-ghost" href="#contact">{t.ctaContact}</a>
			</div>
			<div class="social">
				<a
					href="https://github.com/ahincho"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={t.githubAria}
				>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
						></path>
					</svg>
				</a>
				<a
					href="https://www.linkedin.com/in/ahincho"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={t.linkedinAria}
				>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z"
						></path>
					</svg>
				</a>
				<span class="divider" aria-hidden="true"></span>
				<a class="mail" href="mailto:ahincho@unsa.edu.pe">ahincho@unsa.edu.pe</a>
			</div>
		</div>
		<div class="terminal" aria-hidden="true">
			<div class="bar">
				<span></span><span></span><span></span>
				<em>angel@arequipa — zsh</em>
			</div>
			<pre><code><span class="p">~ $</span> whoami
<span class="o">{t.whoami}</span>
<span class="p">~ $</span> cat stack.json
<span class="o">{stackJson}</span>
<span class="p">~ $</span> echo $NOW
<span class="o">{t.now}</span>{(counterUrl || chatUrl) && (<span class="metrics" hidden>&#10;<span class="p">~ $</span> cat metrics.log{counterUrl && (<span class="o" data-metric="visits" data-one={t.visits.one} data-other={t.visits.other} hidden />)}{counterUrl && (<span class="o" data-metric="downloads" data-one={t.downloads.one} data-other={t.downloads.other} hidden />)}{chatUrl && (<span class="o" data-metric="questions" data-one={t.questions.one} data-other={t.questions.other} hidden />)}</span>)}
<span class="p">~ $</span> <span class="cursor" /></code></pre>
		</div>
	</div>
	<div class="container">
		<dl class="stats">
			{
				t.stats.map((stat) => (
					<div>
						<dt>{stat.label}</dt>
						<dd>{stat.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<script>
	const counterUrl = import.meta.env.PUBLIC_COUNTER_URL;
	const chatUrl = import.meta.env.PUBLIC_CHAT_URL;

	// Inside the check, so a build without either variable emits no script at all.
	if (counterUrl || chatUrl) {
		const wrapper = document.querySelector<HTMLElement>('.metrics');

		if (wrapper) {
			const lang = document.documentElement.lang;
			const number = new Intl.NumberFormat(lang);
			const plural = new Intl.PluralRules(lang);
			const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

			const find = (metric: string) =>
				wrapper.querySelector<HTMLElement>(`[data-metric="${metric}"]`);

			const write = (line: HTMLElement, value: number) => {
				const label = plural.select(value) === 'one' ? line.dataset.one : line.dataset.other;
				// The newline belongs to the line rather than sitting between them, so a
				// metric with nothing to say leaves no blank row behind it.
				line.textContent = `
${number.format(value)} ${label}`;
			};

			// Drawn at zero before anything is asked, so the figures grow into a block
			// that is already there rather than rows arriving when the network answers.
			for (const line of wrapper.querySelectorAll<HTMLElement>('[data-metric]')) {
				write(line, 0);
				line.hidden = false;
			}
			wrapper.hidden = false;

			const climb = (metric: string, value: number) => {
				const line = find(metric);
				if (!line) return;
				// A metric with nothing to report leaves, rather than sitting at zero.
				if (value === 0) {
					line.hidden = true;
					return;
				}
				if (still) {
					write(line, value);
					return;
				}
				const started = performance.now();
				const step = (now: number) => {
					// Eased, so the count leaves zero quickly and settles onto the figure. The
					// frame stamp can predate the call, so the floor keeps it off negatives.
					const through = Math.min(Math.max((now - started) / 900, 0), 1);
					write(line, Math.round(value * (1 - (1 - through) ** 3)));
					if (through < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			};

			const count =
				(field: 'value' | 'questions') =>
				(response: Response): Promise<number> =>
					response.ok
						? response.json().then((body: Record<string, number>) => body[field] ?? 0)
						: Promise.reject(response.status);

			const sources: { metric: string; asked: Promise<number> }[] = [];
			if (counterUrl) {
				sources.push(
					// The visit has to be recorded either way; the rest are only read.
					{
						metric: 'visits',
						asked: fetch(`${counterUrl}/v1/counters/site-visits`, { method: 'POST' }).then(
							count('value'),
						),
					},
					{
						metric: 'downloads',
						asked: fetch(`${counterUrl}/v1/counters/cv-downloads`).then(count('value')),
					},
				);
			}
			if (chatUrl) {
				sources.push({
					metric: 'questions',
					asked: fetch(`${chatUrl}/stats`).then(count('questions')),
				});
			}

			// Each figure climbs as its own answer lands, so a slow endpoint holds up
			// nothing but its own line.
			for (const source of sources) {
				source.asked.then(
					(value) => climb(source.metric, value),
					() => {
						const line = find(source.metric);
						if (line) line.hidden = true;
					},
				);
			}

			// Settled rather than all, so one number failing does not hide the others.
			Promise.allSettled(sources.map((source) => source.asked)).then((results) => {
				const any = results.some((result) => result.status === 'fulfilled' && result.value > 0);
				wrapper.hidden = !any;
			});
		}
	}
</script>

<style>
	.hero {
		position: relative;
		/* The header above this is sticky and 65px tall, so whatever sits here is
	 * on top of that. A flat 4rem left a phone with 129px — a sixth of the
	 * screen — before the first word. Fluid instead of a breakpoint, so the
	 * room grows with the room there is. */
		padding-block: clamp(2.25rem, 7vw, 6.5rem) clamp(3rem, 5vw, 4rem);
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: -20rem;
		right: -10rem;
		width: 42rem;
		height: 42rem;
		background: radial-gradient(circle, var(--accent-dim) 0%, transparent 65%);
		pointer-events: none;
	}

	.grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 3.5rem;
		align-items: center;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.eyebrow::before {
		content: '▸ ';
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.role {
		font-family: var(--font-mono);
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		font-weight: 600;
		/* Three roles are too long for one line on a phone, and the default break
		 * leaves 'Engineer' alone underneath. Balancing splits it where it reads. */
		text-wrap: balance;
		color: var(--accent);
		margin-top: 0.75rem;
	}

	.lead {
		max-width: 34rem;
		color: var(--text-muted);
		font-size: 1.05rem;
		margin-top: 1.25rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.social {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 2rem;
	}

	.social a {
		color: var(--text-muted);
		display: inline-flex;
		/* The icons are 20px, which is under what a thumb needs and under what
		 * WCAG asks for. The padding grows the target and the negative margin
		 * gives back the space, so nothing on the line moves. */
		padding: 0.6rem;
		margin: -0.6rem;
	}

	.social a:hover {
		color: var(--accent);
	}

	.social .mail {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.divider {
		width: 1px;
		height: 1.1rem;
		background: var(--border-strong);
	}

	.terminal {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--shadow);
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.75;
		container-type: inline-size;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--border);
		background: var(--bg-soft);
	}

	.bar span {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.bar span:nth-child(1) {
		background: #f87171;
	}

	.bar span:nth-child(2) {
		background: #fbbf24;
	}

	.bar span:nth-child(3) {
		background: #34d399;
	}

	.bar em {
		margin-left: auto;
		font-style: normal;
		font-size: 0.72rem;
		color: var(--text-faint);
	}

	pre {
		margin: 0;
		padding: 1.1rem 1.25rem 1.3rem;
		overflow-x: auto;
		font-size: clamp(0.62rem, 2.8cqw, 0.8rem);
		scrollbar-width: none;
	}

	pre::-webkit-scrollbar {
		display: none;
	}

	.p {
		color: var(--accent);
		font-weight: 600;
	}

	.o {
		color: var(--text-muted);
	}

	.metrics[hidden],
	.o[data-metric][hidden] {
		display: none;
	}

	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		background: var(--accent);
		vertical-align: text-bottom;
		animation: blink 2.4s ease-in-out infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin: 3.5rem 0 0;
		padding: 1.6rem 0 0;
		border-top: 1px solid var(--border);
	}

	.stats div {
		display: flex;
		flex-direction: column-reverse;
		/* In column-reverse, flex-end is the top: it keeps the numbers on one
		   line even when a label below them wraps to two. */
		justify-content: flex-end;
	}

	.stats dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		color: var(--accent);
		letter-spacing: -0.02em;
	}

	.stats dt {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.stats {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem 1rem;
		}
	}
</style>
