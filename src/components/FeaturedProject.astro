---
import { translations, getLang, defaultLang } from '../i18n';
import VideoDemo from './VideoDemo.astro';

const lang = getLang(Astro.currentLocale);
const t = translations[lang].project;

const caseStudyPath =
	lang === defaultLang ? '/projects/spark-match/' : `/${lang}/projects/spark-match/`;
---

<section id="project" class="section">
	<div class="container">
		<p class="section-eyebrow">{t.eyebrow}</p>
		<h2 class="section-title">{t.title}</h2>
		<article class="card">
			<div class="head">
				<p class="tagline">{t.tagline}</p>
				<div class="badges">
					<span class="badge tfp">{t.badgeTfp}</span>
					<span class="badge status">{t.badgeStatus}</span>
				</div>
			</div>
			<p class="description">{t.description}</p>
			<VideoDemo />
			<a class="cta" href={caseStudyPath}>
				{t.cta}
				<span aria-hidden="true">→</span>
			</a>
		</article>
	</div>
</section>

<style>
	.card {
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 2.2rem 2.4rem;
		box-shadow: var(--shadow);
		position: relative;
		overflow: hidden;
	}

	.card::before {
		content: '';
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, var(--accent), transparent 70%);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		margin-bottom: 1.1rem;
	}

	.tagline {
		font-size: 1.12rem;
		font-weight: 600;
	}

	.badges {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.28rem 0.7rem;
		border-radius: 999px;
	}

	.badge.tfp {
		color: var(--accent);
		background: var(--accent-dim);
		border: 1px solid var(--accent-border);
	}

	.badge.status {
		color: var(--text-muted);
		border: 1px solid var(--border-strong);
	}

	.description {
		color: var(--text-muted);
		max-width: 60rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.8rem;
		font-family: var(--font-mono);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent);
		border-bottom: 1px solid var(--accent-border);
		padding-bottom: 0.15rem;
	}

	.cta span {
		transition: transform 0.2s ease;
	}

	.cta:hover span,
	.cta:focus-visible span {
		transform: translateX(0.25rem);
	}

	@media (max-width: 800px) {
		.card {
			padding: 1.5rem 1.3rem;
		}
	}
</style>
