---
import { translations, getLang } from '../i18n';

const t = translations[getLang(Astro.currentLocale)].projects.assistant;
---

<div class="flow" role="img" aria-label={t.archAria}>
	<p class="flow-label">{t.flowLabel}</p>
	<ol class="steps">
		{
			t.flow.map((step, i) => (
				<li class="step">
					<span class="index" aria-hidden="true">
						{i + 1}
					</span>
					<div class="body">
						<div class="head">
							<span class="name">{step.name}</span>
							<span class="note">{step.note}</span>
						</div>
						<div class="items">
							{step.items.map((item) => (
								<span class="chip">{item}</span>
							))}
						</div>
					</div>
				</li>
			))
		}
	</ol>
</div>

<style>
	.flow {
		margin: var(--space-block) 0;
		padding: 1.3rem 1.4rem;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.flow-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.9rem;
	}

	.steps {
		list-style: none;
		display: grid;
		gap: 0;
	}

	/*
	 * The rail is a border on the marker column rather than a separate element,
	 * so the line cannot drift out of step with the numbers beside it.
	 */
	.step {
		display: grid;
		grid-template-columns: 1.55rem 1fr;
		gap: 0.85rem;
		padding-bottom: 1rem;
	}

	.step:last-child {
		padding-bottom: 0;
	}

	.index {
		position: relative;
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 50%;
		background: var(--accent-dim);
		border: 1px solid var(--accent-border);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.step:not(:last-child) .index::after {
		content: '';
		position: absolute;
		top: 1.7rem;
		bottom: -1.15rem;
		width: 1px;
		background: var(--border);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}

	.name {
		font-weight: 600;
		font-size: 0.92rem;
	}

	.note {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-faint);
	}

	.items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.5rem;
	}

	.chip {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
	}
</style>
