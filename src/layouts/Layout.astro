---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { translations, getLang } from '../i18n';
import ChatWidget from '../components/ChatWidget.astro';
import { cardVersion } from '../lib/og-card';

interface Props {
	title?: string;
	description?: string;
	/** Error pages should stay out of the index, and have no canonical or alternates to offer. */
	noindex?: boolean;
	/** The assistant belongs on the portfolio itself, not on an error page. */
	chat?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = translations[lang];

const {
	title = t.meta.title,
	description = t.meta.description,
	noindex = false,
	chat = true,
} = Astro.props;

/*
 * The sharing card sat at a URL that never changed, so a scraper that fetched it
 * once had no reason to ask again: Discord was still serving the version from
 * before "AI Engineer" was in the role, while reading the new title off the same
 * page. The fingerprint moves the URL whenever the image moves, which is the only
 * thing those caches key on. It is written by the same script that draws the card.
 */
const cardUrl = Astro.site ? new URL(`/og.png?v=${cardVersion}`, Astro.site).href : undefined;

// Every page exists in both languages at the same path, prefixed with /en for English.
const path = Astro.url.pathname;
const esPath = path === '/en' ? '/' : path.startsWith('/en/') ? path.slice(3) : path;
const enPath = esPath === '/' ? '/en/' : `/en${esPath}`;

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Angel Eduardo Hincho Jove',
	alternateName: 'Angel Hincho',
	jobTitle: 'Full Stack, DevSecOps & AI Engineer',
	description: t.meta.description,
	email: 'ahincho@unsa.edu.pe',
	knowsLanguage: ['es', 'en'],
	// Read off the Skills section so the two can never drift apart.
	knowsAbout: t.skills.groups.flatMap((group) => group.items),
	address: { '@type': 'PostalAddress', addressLocality: 'Arequipa', addressCountry: 'PE' },
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Universidad Nacional de San Agustín',
		address: { '@type': 'PostalAddress', addressLocality: 'Arequipa', addressCountry: 'PE' },
	},
	sameAs: ['https://github.com/ahincho', 'https://www.linkedin.com/in/ahincho'],
	...(Astro.site ? { url: new URL('/', Astro.site).href, image: cardUrl } : {}),
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Angel Hincho" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:site_name" content={t.meta.siteName} />
		<meta name="twitter:card" content="summary_large_image" />
		{noindex && <meta name="robots" content="noindex" />}
		{
			Astro.site && !noindex && (
				<>
					<link rel="canonical" href={new URL(path, Astro.site)} />
					<link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
					<link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
					<link rel="alternate" hreflang="x-default" href={new URL(esPath, Astro.site)} />
					<meta property="og:url" content={new URL(path, Astro.site)} />
					{/* Scrapers do not resolve relative paths, so the card image needs the full URL. */}
					<meta property="og:image" content={cardUrl} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:image:alt" content={t.meta.ogImageAlt} />
					<meta name="twitter:image" content={cardUrl} />
				</>
			)
		}
		<script type="application/ld+json" set:html={jsonLd} />
		<script is:inline>
			try {
				const saved = localStorage.getItem('theme');
				const theme =
					saved ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.dataset.theme = theme;
			} catch {
				document.documentElement.dataset.theme = 'dark';
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{t.nav.skipToContent}</a>
		<slot />
		{chat && <ChatWidget />}
	</body>
</html>
